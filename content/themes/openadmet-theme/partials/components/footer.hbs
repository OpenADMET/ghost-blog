<footer class="gh-foot gh-outer">
    <div class="gh-foot-inner gh-inner">
        <span class="gh-foot-logo">
            {{#if @site.logo}}
                <img src="{{@site.logo}}" alt="{{@site.title}}" style="height:64px; opacity:0.9;">
            {{else}}
                {{@site.title}}
            {{/if}}
        </span>
    </div>
</footer>
